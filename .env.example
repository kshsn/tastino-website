# Copy to .env.local (Next) and .env (Prisma CLI) for development. Never commit real values.

# Public base URL, used for canonical and hreflang links (no trailing slash).
SITE_URL=http://localhost:3000

# PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/tastino_dev

# Separate database used only by the integration tests (it is wiped on every run).
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/tastino_test

# Processed images are written here and served at MEDIA_URL_BASE.
MEDIA_DIR=public/media
MEDIA_URL_BASE=/media

# Outgoing email for lead notifications and auto-replies (all optional: without SMTP_HOST, leads are still saved
# and their emails wait; run `npm run leads:retry-emails` after configuring).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Tastino Foods <info@tastinofoods.com>
