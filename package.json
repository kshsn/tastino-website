{
  "name": "tastino-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:content": "vitest run -c vitest.content.config.ts",
    "check:launch": "tsx --env-file=.env scripts/check-launch.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "framer-motion": "14.3.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  }
}
