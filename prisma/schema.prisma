// Tastino Foods website — bilingual catalogue, content, leads and admin.
// Every public text field has an En and Ar column; both are required to publish (US-002.8).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum BrandVisibility {
  LIVE
  COMING_SOON
  HIDDEN
}

/// Products sold under the Tastino name rather than a brand (no brand page).
enum ProductLine {
  FRESHNESS
  TRADITIONAL
  THE_LEAF
}

enum SizeUnit {
  G
  KG
  ML
  L
}

enum PackType {
  GLASS
  PET
  CAN
  TIN
}

enum LeadStatus {
  NEW
  IN_CONTACT
  QUALIFIED
  CLOSED
}

enum LeadReason {
  DISTRIBUTOR
  CATALOGUE
  PRODUCT
  OTHER
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum Role {
  SUPER_ADMIN
  CONTENT_EDITOR
  SALES
}

// ───────────────────────── Catalogue ─────────────────────────

model Brand {
  id              String          @id @default(cuid())
  slug            String          @unique
  nameEn          String
  nameAr          String
  categoryEn      String?
  categoryAr      String?
  taglineEn       String?
  taglineAr       String?
  descriptionEn   String?
  descriptionAr   String?
  accentColor     String
  status          PublishStatus   @default(DRAFT)
  visibility      BrandVisibility @default(LIVE)
  sortOrder       Int             @default(0)
  imageId         String?
  image           MediaAsset?     @relation("BrandImage", fields: [imageId], references: [id], onDelete: SetNull)
  products        Product[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameEn    String
  nameAr    String
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id                    String           @id @default(cuid())
  slug                  String           @unique
  /// Exactly one of brandId / productLine is set (CHECK constraint in migration).
  brandId               String?
  brand                 Brand?           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  productLine           ProductLine?
  categoryId            String
  category              Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  nameEn                String
  nameAr                String
  descriptionEn         String?
  descriptionAr         String?
  ingredientsEn         String?
  ingredientsAr         String?
  shelfLifeEn           String?
  shelfLifeAr           String?
  storageEn             String?
  storageAr             String?
  status                PublishStatus    @default(DRAFT)
  sortOrder             Int              @default(0)
  imageId               String?
  image                 MediaAsset?      @relation("ProductImage", fields: [imageId], references: [id], onDelete: SetNull)
  /// The only packshot shows another brand's label (e.g. Lora jams labelled Liora): never show it publicly.
  imageNeedsReplacement Boolean          @default(false)
  variants              ProductVariant[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([brandId, status])
  @@index([productLine, status])
}

model ProductVariant {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeValue Decimal   @db.Decimal(10, 2)
  unit      SizeUnit
  /// Null when the catalogue does not state the pack (shown as "pack on request").
  packType  PackType?
  sku       String?   @unique
  shown     Boolean   @default(true)
  sortOrder Int       @default(0)

  @@unique([productId, sizeValue, unit, packType])
}

model MediaAsset {
  id          String    @id @default(cuid())
  sha256      String    @unique
  fileName    String
  mime        String
  width       Int
  height      Int
  bytes       Int
  /// { avif: { 320: url, ... }, webp: {...}, original: url }
  derivatives Json
  lowRes      Boolean   @default(false)
  altEn       String?
  altAr       String?
  createdAt   DateTime  @default(now())
  brands      Brand[]   @relation("BrandImage")
  products    Product[] @relation("ProductImage")
  heroSlides  HeroSlide[]
}

enum SlugKind {
  BRAND
  PRODUCT
}

/// Old slug of a renamed brand or product. Public pages answer an old slug with a 301 to `targetSlug`.
model SlugRedirect {
  id         String   @id @default(cuid())
  kind       SlugKind
  oldSlug    String
  targetSlug String
  createdAt  DateTime @default(now())

  @@unique([kind, oldSlug])
}

// ───────────────────────── Content ─────────────────────────

model HeroSlide {
  id          String        @id @default(cuid())
  headlineEn  String
  headlineAr  String
  sublineEn   String?
  sublineAr   String?
  ctaLabelEn  String?
  ctaLabelAr  String?
  ctaHref     String?
  accentColor String?
  imageId     String?
  image       MediaAsset?   @relation(fields: [imageId], references: [id], onDelete: SetNull)
  status      PublishStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model PageBlock {
  id            String        @id @default(cuid())
  key           String        @unique
  titleEn       String
  titleAr       String
  bodyEn        String
  bodyAr        String
  status        PublishStatus @default(DRAFT)
  /// Set when an admin edits the block, so re-seeding never overwrites their text.
  editedByAdmin Boolean       @default(false)
  updatedAt     DateTime      @updatedAt
}

model Setting {
  key       String   @id
  value     Json
  /// Private settings (e.g. SMTP) are never returned by public read functions.
  isPrivate Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// ───────────────────────── Leads ─────────────────────────

/// Archive-only: a database trigger rejects DELETE (US-002.2, US-009.4).
model Lead {
  id                 String      @id @default(cuid())
  reference          String      @unique
  reason             LeadReason
  name               String
  email              String
  phone              String?
  company            String
  country            String
  city               String?
  companyType        String?
  brandsOfInterest   String[]
  product            String?
  message            String
  locale             String
  consent            Boolean
  consentAt          DateTime
  consentTextVersion String
  status             LeadStatus  @default(NEW)
  assigneeId         String?
  assignee           User?       @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  archived           Boolean     @default(false)
  archivedAt         DateTime?
  emailStatus        EmailStatus @default(PENDING)
  /** The separate confirmation email to the visitor. Never sent twice once SENT. */
  autoReplyStatus    EmailStatus @default(PENDING)
  idempotencyKey     String?     @unique
  notes              LeadNote[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([status, archived, createdAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Restrict)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())
}

// ───────────────────────── Admin ─────────────────────────

/// Email is unique case-insensitively (index on lower(email) in migration).
model User {
  id                 String     @id @default(cuid())
  email              String
  name               String
  role               Role
  passwordHash       String?
  totpSecret         String?
  totpEnabled        Boolean    @default(false)
  recoveryCodeHashes String[]
  failedAttempts     Int        @default(0)
  lockedUntil        DateTime?
  active             Boolean    @default(true)
  leads              Lead[]
  notes              LeadNote[]
  auditLogs          AuditLog[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

/// Append-only: a database trigger rejects UPDATE and DELETE (US-007.7).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  /// Restrict: users are deactivated, never deleted, and audit rows must not be rewritten.
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String
  entityId   String?
  ip         String?
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
